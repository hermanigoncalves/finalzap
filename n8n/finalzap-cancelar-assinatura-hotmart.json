    {
      "id": "cde0eccb-0c0e-49a1-9df5-12ab4365cbea",
      "name": "Avaliar assinatura e etapa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const entrada = $('Quando chamado pelo FINALZAP').first().json;\nconst confirmado = entrada.confirmacao_explicita === true || entrada.confirmacao_explicita === 'true';\nconst linhas = $input.all().map((i) => i.json).filter((r) => r && r.id);\nconst agora = DateTime.now().setZone('America/Sao_Paulo');\n\nconst fmtData = (iso) => {\n  if (!iso) return null;\n  const dt = DateTime.fromISO(String(iso), { zone: 'utc' }).setZone('America/Sao_Paulo');\n  return dt.isValid ? dt.toFormat('dd/MM/yyyy') : null;\n};\n\nconst vencFutura = (r) => {\n  if (!r.data_vencimento) return null;\n  const dt = DateTime.fromISO(String(r.data_vencimento));\n  return dt.isValid ? dt > agora : false;\n};\n\nconst ativas = linhas.filter((r) => {\n  if (r.status !== 'Ativo') return false;\n  const vf = vencFutura(r);\n  return vf === null || vf === true;\n});\n\nconst ativa = ativas.find((r) => String(r.hotmart_assinante_codigo || '').trim()) || ativas[0] || null;\n\nif (ativa) {\n  const codigoAssinante = String(ativa.hotmart_assinante_codigo || '').trim();\n  const vencimentoFmt = fmtData(ativa.data_vencimento);\n  const plano = ativa.plano || 'Mensal';\n\n  if (!codigoAssinante) {\n    return [{\n      json: {\n        acao: 'sem_codigo_hotmart',\n        cancelado: false,\n        assinatura_id: ativa.id,\n        plano,\n        vencimento_formatado: vencimentoFmt,\n        mensagem: 'Não encontrei o código da sua assinatura na Hotmart para cancelar automaticamente. Cancele diretamente em purchase.hotmart.com ou fale com o suporte.',\n      },\n    }];\n  }\n\n  if (!confirmado) {\n    const detalheAcesso = vencimentoFmt\n      ? `Você continuará com acesso até ${vencimentoFmt} e não haverá novas cobranças.`\n      : 'As cobranças futuras serão interrompidas.';\n    return [{\n      json: {\n        acao: 'pedir_confirmacao',\n        cancelado: false,\n        precisa_confirmacao: true,\n        assinatura_id: ativa.id,\n        plano,\n        vencimento_formatado: vencimentoFmt,\n        mensagem: `Confirma o cancelamento da sua assinatura ${plano} do FINALZAP na Hotmart? ${detalheAcesso} Responda confirmando para eu efetivar o cancelamento.`,\n      },\n    }];\n  }\n\n  return [{\n    json: {\n      acao: 'executar_hotmart',\n      cancelado: false,\n      assinatura_id: ativa.id,\n      subscriber_code: codigoAssinante,\n      plano,\n      data_vencimento: ativa.data_vencimento || null,\n      vencimento_formatado: vencimentoFmt,\n    },\n  }];\n}\n\nconst jaCancelada = linhas.find((r) => r.status === 'Cancelado' && vencFutura(r) === true);\nif (jaCancelada) {\n  const vencimentoFmt = fmtData(jaCancelada.data_vencimento);\n  return [{\n    json: {\n      acao: 'ja_cancelada',\n      cancelado: false,\n      ja_cancelada: true,\n      assinatura_id: jaCancelada.id,\n      plano: jaCancelada.plano || 'Mensal',\n      vencimento_formatado: vencimentoFmt,\n      mensagem: vencimentoFmt\n        ? `Sua assinatura já está cancelada na Hotmart. Você mantém acesso até ${vencimentoFmt} e não haverá novas cobranças.`\n        : 'Sua assinatura já está cancelada e não haverá novas cobranças.',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    acao: 'nao_encontrada',\n    cancelado: false,\n    plano: '',\n    vencimento_formatado: null,\n    mensagem: 'Não encontrei uma assinatura ativa vinculada a este WhatsApp para cancelar.',\n  },\n}];"
      }
    },
