              "id": "cond-efetivado",
              "leftValue": "={{ (() => { const resp = $('Cancelar assinatura na Hotmart').first().json; const statusHttp = Number(resp?.statusCode ?? 0); const body = resp?.body ?? resp ?? {}; if (statusHttp < 200 || statusHttp >= 300) return false; if (body?.error || body?.error_description) return false; if (Array.isArray(body?.fail_subscriptions) && body.fail_subscriptions.length > 0) return false; const st = String(body?.status || '').toUpperCase(); return ['INACTIVE', 'CANCELLED_BY_SELLER', 'CANCELLED_BY_CUSTOMER', 'CANCELLED_BY_ADMIN', 'CANCELED_BY_SELLER', 'CANCELED_BY_CUSTOMER', 'CANCELED_BY_ADMIN', 'CANCELLED', 'CANCELED'].includes(st); })() }}",
