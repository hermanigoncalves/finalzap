      "id": "ab68f086-b7eb-498a-a79e-621588c585fe",
      "name": "Perfis",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        880,
        1200
      ],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase FINALZAP"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Uma saída por conta de usuário com assinatura ativa (mesma regra do RPC antigo: vencimento nulo ou futuro).\nconst canon = (t) => { let d = String(t || '').replace(/\\D/g, '').replace(/^0+/, ''); if (d.length === 10 || d.length === 11) d = '55' + d; if (d.length === 12 && d.startsWith('55') && /[6-9]/.test(d[4])) d = d.slice(0, 4) + '9' + d.slice(4); return d; };\nconst agora = new Date();\nconst ativos = new Set($('Assinaturas ativas').all().map(i => i.json).filter(r => (r.status === 'Ativo' && (!r.data_vencimento || new Date(r.data_vencimento) > agora)) || (r.status === 'Cancelado' && r.data_vencimento && new Date(r.data_vencimento) > agora)).map(r => canon(r.telefone)));\nconst nomes = {};\nfor (const p of $input.all()) if (p.json.telefone) nomes[canon(p.json.telefone)] = p.json.nome;\nconst hoje = DateTime.now().setZone('America/Sao_Paulo').startOf('day');\nconst brl = (n) => Number(n).toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+,)/g, '.');\nconst out = [];\nfor (const it of $('Contas a lembrar').all()) {\n  const c = it.json;\n  if (!c.id || !ativos.has(canon(c.telefone))) continue;\n  const dias = Math.round(DateTime.fromISO(String(c.vencimento).slice(0, 10), { zone: 'America/Sao_Paulo' }).startOf('day').diff(hoje, 'days').days);\n  const quando = dias === 0 ? 'hoje' : dias === 1 ? 'amanhã' : DateTime.fromISO(String(c.vencimento).slice(0, 10)).toFormat('dd/MM/yyyy');\n  const nome = String(nomes[canon(c.telefone)] || '').trim().split(/\\s+/)[0] || 'cliente';\n  out.push({ json: { telefone: c.telefone, conta_id: c.id, p1: nome, p2: c.descricao, p3: brl(c.valor), p4: quando, tipo_lembrete: dias < 0 ? \"conta_vencida\" : \"vencimento_proximo\" } });\n}\nreturn out;"
      },
