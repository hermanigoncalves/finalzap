      "parameters": {
        "jsCode": "// ativa = 'Ativo' (vencimento nulo ou futuro) ou 'Cancelado' ainda dentro do período pago (vencimento futuro).\n// Sem renovação, o acesso fecha sozinho quando o vencimento passa.\nconst agora = new Date();\nconst vale = (r) => { const v = r.data_vencimento ? new Date(r.data_vencimento) > agora : null; return r.status === 'Ativo' ? (v === null || v) : r.status === 'Cancelado' ? v === true : false; };\nconst ativa = $input.all().map(i => i.json).some(r => r.telefone && vale(r));\nreturn [{ json: { ativa } }];"
      },
