            {
              "fieldId": "categoria",
              "fieldValue": "={{ $fromAI('categoria','Categoria. Despesas: Alimentação, Transporte, Moradia, Saúde, Educação, Lazer, Compras, Contas, Outros. Receitas: Salário, Freelance, Vendas, Outros') }}"
            },
            {
              "fieldId": "descricao",
              "fieldValue": "={{ $fromAI('descricao','Descrição curta da movimentação') }}"
            },
            {
              "fieldId": "data",
              "fieldValue": "={{ $fromAI('data','Data AAAA-MM-DD da movimentação; vazio se for hoje','string','') || $('Normalizar mensagem').first().json.hoje }}"
            },
            {
              "fieldId": "fonte",
              "fieldValue": "whatsapp"
            },
            {
              "fieldId": "idempotency_key",
              "fieldValue": "={{ 'wa:' + $('Normalizar mensagem').first().json.message_id + ':' + (() => { const t=$fromAI('tipo','Tipo da movimentação: receita ou despesa'), v=$fromAI('valor','Valor positivo em reais, número com ponto decimal. Ex: 45.90','number'), c=$fromAI('categoria','Categoria. Despesas: Alimentação, Transporte, Moradia, Saúde, Educação, Lazer, Compras, Contas, Outros. Receitas: Salário, Freelance, Vendas, Outros'), d=$fromAI('descricao','Descrição curta da movimentação'); const s=[t,v].join('|');let h1=0xdeadbeef,h2=0x41c6ce57;for(let i=0;i<s.length;i++){const ch=s.charCodeAt(i);h1=Math.imul(h1^ch,2654435761);h2=Math.imul(h2^ch,1597334677);}h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);return (4294967296*(2097151&h2)+(h1>>>0)).toString(16); })() }}"
            }
          ]
        },
        "descriptionType": "manual",
        "toolDescription": "Registra uma receita ou despesa em reais (BRL) do cliente. Retorna a linha criada quando salvou. Erro de chave duplicada (idempotency_key) significa que já estava registrado. O telefone é automático."
