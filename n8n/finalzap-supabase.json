    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst msg = body.messages?.[0] ?? {};\nconst from = String(msg.from ?? body.contacts?.[0]?.wa_id ?? '');\n// Mesma regra de public.normalizar_telefone_br\nlet d = from.replace(/\\D/g, '').replace(/^0+/, '');\nif (d.length === 10 || d.length === 11) d = '55' + d;\nif (d.length === 12 && d.startsWith('55') && /[6-9]/.test(d[4])) d = d.slice(0, 4) + '9' + d.slice(4);\n// variante antiga sem o 9º dígito (cadastros antigos); iguais quando não se aplica\nconst alt = (d.length === 13 && d.startsWith('55') && d[4] === '9') ? d.slice(0, 4) + d.slice(5) : d;\nconst sp = DateTime.now().setZone('America/Sao_Paulo');\nreturn [{ json: {\n  telefone: d,\n  telefone_alt: alt,\n  wa_id: from,\n  message_id: msg.id,\n  tipo: msg.type,\n  texto: msg.text?.body ?? '',\n  audio_id: msg.audio?.id ?? null,\n  phone_number_id: body.metadata?.phone_number_id,\n  hoje: sp.toFormat('yyyy-MM-dd'),\n  mes: sp.toFormat('yyyy-MM'),\n} }];"
      },
