{
  "name": "whatsapp-fin-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "test": "node --test \"tests/*.test.*\"",
    "bot:dev": "npm run dev --prefix bot-server",
    "bot:start": "npm start --prefix bot-server",
    "higiene": "node scripts/higiene.mjs",
    "regras": "node scripts/regras-cobertas.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "verificar": "npm run lint && npm run typecheck && npm run higiene && npm run regras && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "openai": "^7.59.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  }
}
