# Variáveis das funções serverless (Vercel). Configure no painel, nunca em arquivo versionado.
# Chave de serviço NUNCA em variável VITE_* (o Vite a embutiria no bundle do navegador).
# (O frontend usa frontend/.env com VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY.)

# --- Supabase ---
# OBRIGATÓRIA. Usada por: todas as funções em api/ e lib/serverEnv.ts.
SUPABASE_URL=https://seu-projeto.supabase.co
# OBRIGATÓRIA. Usada por: lib/auth/jwtAuth.ts (valida o JWT do usuário no painel).
SUPABASE_ANON_KEY=sua_anon_public_key
# OBRIGATÓRIA. Usada por: api/whatsapp/*, api/hotmart/webhook, api/admin/*. Segredo do servidor.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# OPCIONAL (só para o endpoint interno api/whatsapp/webhook e o legado Baileys). Header x-bot-secret; use um valor longo e aleatório.
BOT_SECRET_TOKEN=um_segredo_longo_aleatorio
# OPCIONAL (só legado Baileys). Usada por: api/whatsapp/instances/* e bot-server.
BOT_SERVER_URL=https://seu-bot.onrender.com
# OBRIGATÓRIA em produção. Origens permitidas por CORS (separadas por vírgula).
# Usada por: api/whatsapp/instances/*, api/admin/* e bot-server.
ALLOWED_ORIGINS=https://seu-app.vercel.app
# OBRIGATÓRIA. URL pública do painel (link do convite pós-compra). Usada por: api/hotmart/webhook.
APP_URL=https://seu-app.vercel.app

# --- Hotmart ---
# OBRIGATÓRIA. Token (hottok) do webhook. Usada por: api/hotmart/webhook.ts. Sem ele, o webhook recusa tudo.
HOTMART_HOTTOK=token_do_webhook_hotmart
# OPCIONAL (padrão 8889619): id do produto aceito. Use 0 ou 788921 só para testar com o sandbox da Hotmart.
# HOTMART_PRODUTO_ID=8889619

# OPCIONAL (só para api/whatsapp/webhook, que interpreta texto com a OpenAI). O n8n usa a credencial OpenAI própria.
OPENAI_API_KEY=sua_chave_openai
# OPCIONAL (padrão 5.50). Cotação USD->BRL para registrar o custo em reais.
USD_BRL=5.50

# OPCIONAL: só se o callback da Meta apontar para api/whatsapp/meta (hoje o n8n recebe as conversas). Verificação GET do webhook.
META_VERIFY_TOKEN=um_texto_secreto_que_voce_escolhe
# OPCIONAL: junto com META_VERIFY_TOKEN. Valida a assinatura X-Hub-Signature-256.
META_APP_SECRET=app_secret_do_app_na_meta
# OBRIGATÓRIA para métricas. Usadas por: api/whatsapp/metricas.ts (consulta a Graph API).
META_ACCESS_TOKEN=token_de_acesso_do_usuario_do_sistema
META_WABA_ID=id_da_conta_whatsapp_business
# OPCIONAL. Versão da Graph API (padrão v21.0).
# META_GRAPH_VERSION=v21.0
# OPCIONAL. Sobrescreve as tarifas em USD por mensagem.
# META_TARIFAS_USD={"marketing":0.0625,"utility":0.0068,"authentication":0.0315}

# --- Somente desenvolvimento local ---
# OPCIONAL. NUNCA em produção. Usada por: lib/auth/jwtAuth.ts (só vale com NODE_ENV=development).
# ALLOW_DEV_MOCK_AUTH=true
